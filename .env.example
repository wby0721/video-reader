# =====================================================================
# Video Agent 环境变量模板 —— 复制为 .env 并填入你的真实密钥
# .env 已被 .gitignore 忽略，绝不会提交到仓库；真实密钥只存在于本机/服务器
# =====================================================================

# ---- LLM（DeepSeek，OpenAI 兼容）----
# 未配置时：Agent 调用会提示需要 Key；用户可在前端「个人设置」提交自己的 Key（AES-GCM 加密落库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- 用户密钥静态加密主密钥（生产必设！）----
# 生成方式：openssl rand -base64 32  （或 powershell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))）
# 它用于加密落库的用户 LLM/讯飞密钥；更换后旧密文无法解密（用户需重新提交）
LLM_MASTER_KEY=

# ---- 科大讯飞极速录音转写（在线 ASR，可选；用户也可在设置页自行提交）----
XF_APPID=
XF_APIKEY=
XF_APISECRET=

# ---- 基础设施（服务器部署按需覆盖）----
# MYSQL_URL=jdbc:mysql://127.0.0.1:3307/video_agent?...
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=root123
# JWT_SECRET=请改成至少32位随机字符串
# MINIO_ENDPOINT=http://127.0.0.1:9000
# QDRANT_BASE_URL=http://127.0.0.1:6333
# RATE_LIMIT_USER_RPS=2
# RATE_LIMIT_GLOBAL_RPS=3
