# =====================================================================
# Video Reader 环境变量模板 —— 复制为 .env 并填入你的真实密钥
# .env 已被 .gitignore 忽略，绝不会提交到仓库；真实密钥只存在于本机/服务器
# =====================================================================

# ---- LLM（DeepSeek，OpenAI 兼容）----
# 未配置时：Agent 调用会提示需要 Key；用户可在前端「个人设置」提交自己的 Key（AES-GCM 加密落库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- 用户密钥静态加密主密钥（生产必设！）----
# 生成方式：openssl rand -base64 32  （或 powershell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))）
# 它用于加密落库的用户 LLM/讯飞密钥；更换后旧密文无法解密（用户需重新提交）
LLM_MASTER_KEY=

# ---- 科大讯飞极速录音转写（在线 ASR，可选；用户也可在设置页自行提交）----
XF_APPID=
XF_APIKEY=
XF_APISECRET=

# ---- Tavily 网页搜索（选中术语解释的联网检索，可选）----
TAVILY_API_KEY=

# ---- 生产必填：Docker 部署（docker-compose.prod.yml 使用，缺失会启动失败）----
# 生成方法（在服务器上执行）：
#   openssl rand -base64 32        # 用于 JWT_SECRET / LLM_MASTER_KEY
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16   # 或用于各密码
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
JWT_SECRET=
# RATE_LIMIT_USER_RPS=2
# RATE_LIMIT_GLOBAL_RPS=3

# ---- 基础设施（本地开发按需覆盖；服务器 Docker 部署无需修改）----
# MYSQL_URL=jdbc:mysql://127.0.0.1:3307/video_agent?...
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=root123
# MINIO_ENDPOINT=http://127.0.0.1:9000
# QDRANT_BASE_URL=http://127.0.0.1:6333
